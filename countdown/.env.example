# Absolute API origin. Leave it EMPTY for local dev: the app then calls a
# relative /api, which the Vite dev proxy forwards to mobius-api on
# http://localhost:3001.
#
# In production the SPA is served from {client}.vencimientos.mobiusboxing.com
# and the API from api.mobiusboxing.com — a different origin — so the deployed
# bundle IS built with this set, and that origin has to be in the API's CORS
# allowlist. It covers the public whitelabel/branding call too.
VITE_API_URL=

# Dev/preview only: pretend we are on {slug}.vencimientos.mobiusboxing.com so
# branding can be exercised on localhost. `?tenant=<slug>` in the URL wins over
# it. Leave EMPTY for any real build — the hostname decides there.
VITE_TENANT=
